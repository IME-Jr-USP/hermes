{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"plugins": ["eslint", "typescript", "unicorn", "oxc", "react"],
	"env": {
		"browser": true,
		"node": true
	},
	"categories": {
		"correctness": "error",
		"suspicious": "warn",
		"pedantic": "off",
		"perf": "off",
		"style": "off",
		"restriction": "off",
		"nursery": "off"
	},
	"rules": {
		"react/react-in-jsx-scope": "off"
	}
}
